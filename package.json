{
  "name": "gamejan",
  "version": "1.0.0",
  "type": "module",
  "description": "Jan's World - A Super Mario Bros style browser game",
  "scripts": {
    "dev": "vite",
    "dev:full": "wrangler pages dev --d1 DB=dcfd3307-6e26-40cb-853e-fd9d52dd3356 -- vite",
    "db:init:local": "wrangler d1 execute jansworld-db --local --file=schema.sql -y",
    "db:init:remote": "wrangler d1 execute jansworld-db --remote --file=schema.sql -y",
    "build": "npm run db:init:remote && vite build",
    "preview": "vite preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "vite": "^4.5.14",
    "wrangler": "^4.87.0"
  }
}
